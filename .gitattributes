# Authored on Windows, executed on the Linux cluster -- keep LF in the repo so
# shell scripts and Python written here stay runnable on hyde06 after checkout.
* text=auto eol=lf

# Meshes are large ASCII; treat as binary so git never diffs or rewrites them.
*.obj binary
*.mtl binary
*.ply binary
*.exr binary
*.npz binary
*.gif binary
*.png binary
*.jpg binary

# Generated reports embed base64 payloads -- diffing them is noise.
docs/*.html linguist-documentation -diff
