% Chapter 4: the two controls (FIGS_V2, 2026-10-22; after the user's reference sketch: two panels, flat greys, blue
% accent, black cameras, dashed target, legend on top). Left: the stress increment dF_c reshapes the body through the
% MPM grid, cell by cell, so relief finer than a cell is out of its reach. Right: the layer offset moves each
% outer-layer particle along its normal by u_p (below the grid, rigid modes removed); the render terms read the
% exterior's surface discs from several views.
% Included by Chapter4.tex with
%   \resizebox{\textwidth}{!}{\input{figs/ch4/controls_overview.tikz}}
% Needs \usepackage{tikz,amsmath} and \usetikzlibrary{arrows.meta}; the text takes the document font (Times through
% mathptmx in the dissertation). Font sizes are fixed in pt. Coordinates in cm, drawn at 16.5 cm (the text width).
% Schematic, not data: s(x) is the body's surface before the step, t(x) the target's cell-scale shape (what the grid can
% reach), b(x) its sub-cell relief (wavelength 0.6 cm against the 0.8-cm cell).
\begin{tikzpicture}[
  font=\fontsize{7.6}{9.2}\selectfont,
  declare function={
    s(\x) = 2.25 + 0.85*exp(-((\x-3.85)/2.0)^2);
    t(\x) = 3.05 + 1.15*exp(-((\x-3.85)/2.0)^2);
    tp(\x) = -0.575*(\x-3.85)*exp(-((\x-3.85)/2.0)^2);
    b(\x) = 0.22*sin(600*\x) + 0.06*sin(1500*\x + 30);
  },
  bodyfill/.style={fill=black!11},
  bodyline/.style={draw=black!62, line width=0.8pt},
  pin/.style={fill=black!38},
  pout/.style={fill=black!82},
  target/.style={draw=black, line width=0.75pt, dash pattern=on 3.2pt off 2.2pt},
  reach/.style={draw=black!55, line width=0.6pt, dash pattern=on 0.6pt off 1.4pt},
  grid/.style={draw=black!22, line width=0.35pt},
  dfc/.style={-{Stealth[length=2.6mm, width=1.9mm]}, draw=black!72, fill=black!72, line width=1.3pt},
  uarrow/.style={-{Stealth[length=1.6mm, width=1.3mm]}, draw=blue!75!black, fill=blue!75!black, line width=0.85pt},
  ray/.style={draw=black!60, line width=0.4pt, dash pattern=on 0.5pt off 1.6pt},
  band/.style={fill=blue!45, fill opacity=0.33},
  ttl/.style={font=\fontsize{9.4}{11}\selectfont\bfseries, anchor=west},
  note/.style={font=\fontsize{7.1}{8.4}\selectfont, align=left},
  camera/.pic={
    \fill[black] (-0.24,0) rectangle (0.24,0.30);
    \fill[black] (-0.13,0) -- (0.13,0) -- (0.19,-0.13) -- (-0.19,-0.13) -- cycle;
    \fill[black] (-0.18,0.30) rectangle (-0.04,0.36);
  },
]
% ------------------------------------------------------------------------------------------------ legend
\begin{scope}[shift={(0.2,7.05)}]
  \draw[target] (0,0) -- (0.65,0);                         \node[anchor=west] at (0.72,0) {target surface};
  \fill[black!38] (2.65,0) circle (0.045);                 \node[anchor=west] at (2.75,0) {particle};
  \fill[black!82] (3.95,0) circle (0.05);                  \node[anchor=west] at (4.05,0) {outer-layer particle};
  \draw[grid] (6.50,-0.13) rectangle (6.80,0.13);
  \draw[grid] (6.80,-0.13) rectangle (7.10,0.13);          \node[anchor=west] at (7.17,0) {MPM grid cell};
  \draw[dfc] (9.05,-0.03) -- (9.65,-0.03);                 \node[anchor=west] at (9.72,0) {$\delta\mathbf{F}_c$ through the grid};
  \draw[uarrow] (12.40,0) -- (12.80,0);                    \node[anchor=west] at (12.85,0) {$u_p\,\mathbf{n}_p$};
  \fill[band] (13.80,-0.09) rectangle (14.30,0.09);        \node[anchor=west] at (14.35,0) {surface discs};
\end{scope}
% ------------------------------------------------------------------------------------------------ left panel
\begin{scope}
  \draw[black!25, line width=0.5pt, rounded corners=3pt] (0,0) rectangle (7.9,6.55);
  \node[ttl] at (0.2,6.22) {(a) Stress increment $\delta\mathbf{F}_c$: through the grid};
  \begin{scope}
    \clip (0.05,0.05) rectangle (7.85,5.95);
    \fill[bodyfill] (0.2,0.2) -- plot[domain=0.2:7.7, samples=160] (\x,{s(\x)}) -- (7.7,0.2) -- cycle;
    \foreach \ii in {0,...,29} {\foreach \jj in {0,...,14} {
      \pgfmathsetmacro\px{0.30+0.25*\ii+0.045*sin(\ii*137+\jj*71)}
      \pgfmathsetmacro\py{0.32+0.25*\jj+0.045*cos(\ii*53+\jj*113)}
      \pgfmathsetmacro\plim{s(\px)-0.24}
      \ifdim\py pt<\plim pt \fill[pin] (\px,\py) circle (0.034); \fi
    }}
    \foreach \k in {0,...,37} {
      \pgfmathsetmacro\px{0.30+0.2*\k}
      \fill[pout] (\px,{s(\px)-0.11}) circle (0.042);
    }
    \draw[bodyline] plot[domain=0.2:7.7, samples=160] (\x,{s(\x)});
    \draw[grid] (-0.4,-0.4) grid[step=0.8] (8.4,6.4);
    % the cell-scale target shape the grid can reach, and the target with its sub-cell relief
    \draw[reach] plot[domain=0.2:7.7, samples=160] (\x,{t(\x)});
    \draw[target] plot[domain=0.2:7.7, samples=400] (\x,{t(\x)+b(\x)});
    % the stress increment's effect: one smooth push per cell
    \foreach \cc in {0,...,9} {                         % the cell centres (TikZ's grid lines lie on multiples of 0.8)
      \pgfmathsetmacro\cx{0.4+0.8*\cc}
      \pgfmathsetmacro\dy{0.85*(t(\cx)-s(\cx))}
      \draw[dfc] (\cx,{s(\cx)-0.95}) -- ++(0,\dy);
      \draw[dfc, line width=0.9pt, draw=black!50, fill=black!50] (\cx,{s(\cx)-1.75}) -- ++(0,{0.55*\dy});
    }
  \end{scope}
  % one cell, labelled
  \draw[black!80, line width=0.8pt] (4.8,0.8) rectangle (5.6,1.6);
  \node[note, anchor=east, fill=white, fill opacity=0.85, text opacity=1, inner sep=1.5pt, rounded corners=1pt]
    at (4.7,1.2) {one MPM cell\\(${\approx}\,180$ particles at 300k)};
  \draw[black!70, line width=0.5pt] (2.15,{t(2.15)+b(2.15)+0.08}) -- (1.55,5.15);
  \node[note, anchor=south] at (1.55,5.12) {relief finer than a cell:\\out of reach of $\delta\mathbf{F}_c$};
  \draw[black!55, line width=0.5pt] (6.65,{t(6.65)}) -- (6.65,4.7);
  \node[note, anchor=south] at (6.65,4.68) {cell-scale shape\\the grid can reach};
\end{scope}
% ------------------------------------------------------------------------------------------------ right panel
\begin{scope}[shift={(8.6,0)}]
  \draw[black!25, line width=0.5pt, rounded corners=3pt] (0,0) rectangle (7.9,6.55);
  \node[ttl] at (0.2,6.22) {(b) Layer offset $u$: below the grid};
  \begin{scope}
    \clip (0.05,0.05) rectangle (7.85,5.95);
    \fill[bodyfill] (0.2,0.2) -- plot[domain=0.2:7.7, samples=160] (\x,{t(\x)}) -- (7.7,0.2) -- cycle;
    \foreach \ii in {0,...,29} {\foreach \jj in {0,...,17} {
      \pgfmathsetmacro\px{0.30+0.25*\ii+0.045*sin(\ii*137+\jj*71)}
      \pgfmathsetmacro\py{0.32+0.25*\jj+0.045*cos(\ii*53+\jj*113)}
      \pgfmathsetmacro\plim{t(\px)-0.26}
      \ifdim\py pt<\plim pt \fill[pin] (\px,\py) circle (0.034); \fi
    }}
    \draw[bodyline, draw=black!40, line width=0.6pt] plot[domain=0.2:7.7, samples=160] (\x,{t(\x)});
    % the exterior's surface discs on the moved outer layer, and the target
    \fill[band] plot[domain=0.2:7.7, samples=400] (\x,{t(\x)+b(\x)+0.09})
      -- plot[domain=7.7:0.2, samples=400] (\x,{t(\x)+b(\x)-0.07}) -- cycle;
    \draw[target] plot[domain=0.2:7.7, samples=400] (\x,{t(\x)+b(\x)});
    % the outer layer and its offsets along the normals
    \foreach \k in {0,...,37} {
      \pgfmathsetmacro\px{0.30+0.2*\k}
      \pgfmathsetmacro\nl{sqrt(1+tp(\px)^2)}
      \pgfmathsetmacro\nx{-tp(\px)/\nl}
      \pgfmathsetmacro\ny{1/\nl}
      \pgfmathsetmacro\bb{b(\px)}
      \pgfmathsetmacro\ax{\px-0.13*\nx}
      \pgfmathsetmacro\ay{t(\px)-0.13*\ny}
      \fill[pout] (\ax,\ay) circle (0.042);
      \pgfmathsetmacro\bigq{abs(\bb) > 0.06 ? 1 : 0}
      \ifnum\bigq=1 \draw[uarrow] (\ax,\ay) -- ++({\bb*\nx},{\bb*\ny}); \fi
    }
  \end{scope}
  % three of the render's views
  \foreach \cx/\cy/\tx in {1.5/4.95/1.0, 3.85/5.15/3.85, 6.2/4.95/6.7} {
    \pic at (\cx,\cy) {camera};
    \foreach \dx in {-0.55, 0, 0.55} {
      \pgfmathsetmacro\qx{\tx+\dx}
      \draw[ray] (\cx,\cy-0.14) -- (\qx,{t(\qx)+b(\qx)+0.1});
    }
  }
  \node[note, anchor=north east] at (7.75,5.93) {the render terms read these discs from 18 views};
  \draw[black!70, line width=0.5pt] (2.62,{t(2.62)+b(2.62)-0.02}) -- (1.95,1.25);
  \node[note, anchor=north] at (1.95,1.25) {$u_p\,\mathbf{n}_p$ on the outer layer:\\sub-cell, free of rigid modes};
  \draw[black!70, line width=0.5pt] (5.35,{t(5.35)+b(5.35)+0.06}) -- (5.9,1.25);
  \node[note, anchor=north] at (5.95,1.25) {surface discs of the\\exterior field};
\end{scope}
\end{tikzpicture}
