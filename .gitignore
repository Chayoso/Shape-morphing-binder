# ---------------------------------------------------------------------------
# Third-party tree kept on disk but not in this repo.
#   gaussian-splatting/ is an unmodified graphdeco-inria clone (134 MB, of which
#   80 MB is demo GIFs). physmorph/render/photoreal.py imports its rasteriser as
#   an installed package (diff_gaussian_rasterization), never by path, so the
#   clone is a build source, not a dependency of this code. See AGENTS.md.
# ---------------------------------------------------------------------------
gaussian-splatting/

# Compiled C++ oracle. legacy/include/ (vendored Eigen/glm/igl/cereal headers)
# IS tracked -- without it the bindings cannot be rebuilt and nothing else
# records the versions. Only the build products are dropped.
legacy/build/
*.so
*.pyd
*.dll
*.dylib
*.o
*.a

# Python
__pycache__/
*.py[cod]
*$py.class
build/
dist/
sdist/
develop-eggs/
.eggs/
*.egg
*.egg-info/

# Environments
venv/
env/
ENV/
.conda/

# Editor / agent local state
.vscode/
.idea/
.codex
.codex/
.claude/settings.local.json
.claude/scheduled_tasks.lock
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Results. output/ is regenerated by every run; it was 317 MB before the reset.
# ---------------------------------------------------------------------------
output/
debug/
logs/
*.log
*.tmp
.cache/

# Heavy renders. Meshes under assets/ are simulation INPUTS and are tracked --
# the previous blanket `*.obj` rule (meant for MSVC object files) silently
# excluded every one of them.
*.exr
*.ply
*.mp4
*.png
*.jpg
*.jpeg
!assets/**
!docs/**

# OS
.DS_Store
Thumbs.db
